{
  // Static Astro build served by Workers static assets. No Worker script, no adapter.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josue-codes",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom Domains: Cloudflare creates the DNS records and certificates for these names only. Other records on
  // the zone (the iCloud MX records for email) are left alone.
  "routes": [
    // previews_enabled also serves each pull-request Preview at <branch>.josue.codes. Production stays on (never set
    // "enabled": false here, which would make the route preview-only and take the live site off josue.codes).
    { "pattern": "josue.codes", "custom_domain": true, "previews_enabled": true },
    { "pattern": "www.josue.codes", "custom_domain": true }
  ],
  // Pull-request builds run `npx wrangler preview`, which needs this block (empty is fine). Previews are public, on
  // <branch>.josue.codes and on workers.dev.
  "preview_urls": true,
  "previews": {}
}
