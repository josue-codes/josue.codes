{
  // Static Astro build served by Workers static assets. No Worker script, no adapter.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "josue-codes",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Custom Domains: Cloudflare creates the DNS records and certificates for these names only. Other records on
  // the zone (the iCloud MX records for email) are left alone.
  "routes": [
    { "pattern": "josue.codes", "custom_domain": true },
    { "pattern": "www.josue.codes", "custom_domain": true }
  ],
  // Pull-request builds run `npx wrangler preview`, which needs this block (empty is fine). Previews get a public
  // workers.dev URL; the custom-domain routes above stay production-only.
  "preview_urls": true,
  "previews": {}
}
