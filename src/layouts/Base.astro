---
import '../styles/global.css';
import { site } from '../site';
import { palettes, DEFAULT_PALETTE, DEFAULT_MODE } from '../themes';
import Mark from '../components/Mark.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.positioning } = Astro.props;
const pageTitle = title ? `${title} | ${site.displayName}` : site.displayName;
const legalPages = [
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: '/terms/', label: 'Terms of Use' },
  { href: '/cookies/', label: 'Cookie Policy' },
  { href: '/accessibility/', label: 'Accessibility Statement' },
];
const path = Astro.url.pathname;
const current = (href: string) => (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
const paletteIds = palettes.map((p) => p.id);
---

<html lang="en" data-palette={DEFAULT_PALETTE} data-mode={DEFAULT_MODE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#1e1e1e" />
    {/* Apply the visitor's saved palette and mode before first paint, so a saved choice never flashes the default. */}
    <script is:inline define:vars={{ paletteIds }}>
      const root = document.documentElement;
      root.classList.add('js');
      try {
        const palette = localStorage.getItem('palette');
        const mode = localStorage.getItem('mode');
        if (paletteIds.includes(palette)) root.dataset.palette = palette;
        if (mode === 'light' || mode === 'dark') root.dataset.mode = mode;
      } catch {
        // Storage blocked (private window, strict settings): keep the defaults.
      }
    </script>
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <nav class="site-nav" aria-label="Main">
          <div class="nav-group nav-left">
            <a href="/work/" aria-current={current('/work/')}>Work</a>
            <a href="/about/" aria-current={current('/about/')}>About</a>
            <a href="/resume/" aria-current={current('/resume/')}>Résumé</a>
          </div>
          <a class="nav-home" href="/" aria-label={`${site.name}, home`} aria-current={current('/')}>
            {site.photo ? <Image src={site.photo} alt="" width={80} densities={[1, 2]} loading="eager" /> : <Mark />}
          </a>
          <div class="nav-group nav-right">
            <a href={`mailto:${site.email}`}>Email</a>
            <a href={site.source}><Icon name="github" />Source</a>
          </div>
        </nav>
        <div class="prefs" role="group" aria-label="Appearance">
          <label class="visually-hidden" for="palette-select">Theme</label>
          <select id="palette-select" class="pref-select">
            {palettes.map((p) => <option value={p.id}>{p.label}</option>)}
          </select>
          <button id="mode-toggle" class="pref-button" type="button" aria-pressed="false">
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"
              ><circle cx="12" cy="12" r="4"></circle><path
                d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
              ></path></svg
            >
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg
            >
            <span class="visually-hidden">Light mode</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell">
        {/* Legal links sit behind one label. Hover or keyboard focus opens them; a tap toggles them (script below). */}
        <div class="legalese">
          <button class="legalese-toggle" type="button" aria-expanded="false" aria-controls="legal-links">
            Legalese
          </button>
          <ul id="legal-links" class="legalese-menu">
            {
              legalPages.map((p) => (
                <li>
                  <a href={p.href} aria-current={current(p.href)}>
                    {p.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <ul class="contact-row">
          <li><a href={site.linkedin} rel="me"><Icon name="linkedin" />LinkedIn</a></li>
          <li><a href={site.github} rel="me"><Icon name="github" />GitHub</a></li>
          <li><a href={site.source}><Icon name="github" />Source</a></li>
        </ul>
      </div>
    </footer>
    {/* Legalese menu: tap or Enter toggles it, Escape or a click elsewhere closes it. */}
    <script is:inline>
      (() => {
        const wrap = document.querySelector('.legalese');
        const button = wrap.querySelector('.legalese-toggle');
        const set = (open) => {
          wrap.classList.toggle('is-open', open);
          button.setAttribute('aria-expanded', String(open));
        };
        button.addEventListener('click', () => set(!wrap.classList.contains('is-open')));
        document.addEventListener('click', (e) => {
          if (!wrap.contains(e.target)) set(false);
        });
        wrap.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            set(false);
            button.focus();
          }
        });
      })();
    </script>
    {/* Theme controls. Without JavaScript they stay hidden and the page uses the defaults set on <html>. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const select = document.getElementById('palette-select');
        const toggle = document.getElementById('mode-toggle');
        const meta = document.querySelector('meta[name="theme-color"]');
        const save = (key, value) => {
          try {
            localStorage.setItem(key, value);
          } catch {
            // Storage blocked: the choice still applies to this page view.
          }
        };
        const sync = () => {
          const light = root.dataset.mode === 'light';
          select.value = root.dataset.palette;
          toggle.setAttribute('aria-pressed', String(light));
          toggle.title = light ? 'Switch to dark mode' : 'Switch to light mode';
          meta.content = getComputedStyle(root).getPropertyValue('--paper').trim();
        };
        select.addEventListener('change', () => {
          root.dataset.palette = select.value;
          save('palette', select.value);
          sync();
        });
        toggle.addEventListener('click', () => {
          root.dataset.mode = root.dataset.mode === 'light' ? 'dark' : 'light';
          save('mode', root.dataset.mode);
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
