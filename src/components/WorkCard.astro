---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const href = `/work/${entry.id}/`;
---

<li class="entry">
  <div class="entry-body">
    <h3 class="entry-title"><a href={href}>{entry.data.title}</a></h3>
    <p class="entry-summary">{entry.data.summary}</p>
  </div>
  <div class="entry-outcome">
    <p class="eyebrow">Outcome</p>
    <p>{entry.data.outcome}</p>
  </div>
  <p class="entry-cta" aria-hidden="true">Read the case study<span class="arrow">→</span></p>
</li>
