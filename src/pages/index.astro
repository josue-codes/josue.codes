---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site';
import { getPublishedWork } from '../lib/work';

const work = await getPublishedWork();
---

<Base>
  <h1>{site.name}</h1>
  <p class="lede">{site.positioning}</p>
  <p>
    <a class="button" href={`mailto:${site.email}`}>Email me</a>
    {site.resumeUrl && <> <a href={site.resumeUrl}>Resume (PDF)</a></>}
  </p>
  {site.openTo && <p>{site.openTo}</p>}

  <h2>Selected work</h2>
  {work.map((entry) => <WorkCard entry={entry} />)}
  <p><a href="/work/">All case studies</a></p>
</Base>
