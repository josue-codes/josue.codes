---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import { site } from '../site';
import { getPublishedWork } from '../lib/work';

const work = await getPublishedWork();
const featured = work[0];
---

<Base>
  <section class="hero" aria-labelledby="intro">
    <div class="hero-copy">
      <p class="eyebrow">{site.role}</p>
      <h1 id="intro">{site.displayName}</h1>
      <p class="lede">{site.positioning}</p>
      {site.openTo && <p class="status">{site.openTo}</p>}
      <div class="hero-actions">
        <a class="button" href={`mailto:${site.email}`}>Email me</a>
        {site.resumeUrl && <a class="button button-secondary" href={site.resumeUrl}>Resume</a>}
        {featured && <a href={`/work/${featured.id}/`}>Read a case study<span class="arrow">→</span></a>}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="selected-work">
    <div class="section-head">
      <h2 id="selected-work">Selected Work</h2>
      <p><a href="/work/">All case studies<span class="arrow">→</span></a></p>
    </div>
    <ul class="entry-list">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </ul>
  </section>
</Base>
