---
// The one place for contact details (ADR 0004). Other pages link here instead of restating them; the legal pages
// keep the contact details their own text needs.
//
// The list is drawn like lines in an editor: a gutter number, an accent icon as each row's label mark, and a cursor
// on one row (the tint band, the accent bar and number, and the arrow). The cursor starts on the email row
// (`data-current`) and moves with hover or keyboard focus; all of that is CSS, see "Contact" in global.css.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';

const handle = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const rows = [
  { icon: 'mail', label: 'Email', href: `mailto:${site.email}`, text: site.email, me: false },
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin, text: handle(site.linkedin), me: true },
  { icon: 'github', label: 'GitHub', href: site.github, text: handle(site.github), me: true },
] as const;
---

<Base title="Contact" description={`How to reach ${site.displayName}.`}>
  <section class="contact">
    <p class="eyebrow">Contact</p>
    <h1>Get in Touch</h1>
    <dl class="contact-list">
      {
        rows.map((row, index) => (
          <div data-current={index === 0 ? '' : undefined}>
            <dt class="contact-label">
              <Icon name={row.icon} />
              <span>{row.label}</span>
            </dt>
            <dd>
              <a href={row.href} rel={row.me ? 'me' : undefined}>
                {row.text}
                <span class="go" aria-hidden="true">↗</span>
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>
