---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import { site } from '../site';
---

<Base title="About">
  <section class="about">
    <Portrait variant="about" />
    <div class="about-copy">
      <p class="eyebrow">About</p>
      <h1>{site.displayName}</h1>
      <p class="lede">{site.positioning}</p>
      <p>
        I lead an engineering team and I write code. I do both at B-Stock, and most of that work is private, so the case studies
        here describe it within the limits of my confidentiality obligations.
      </p>
    </div>
  </section>
</Base>
