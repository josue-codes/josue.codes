---
// One template for every legal page in src/content/legal/. Static routes (about, work) take precedence.
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((entry) => ({ params: { legal: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const updated = entry.data.updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="legal">
    <header class="case-header wrap">
      <p class="eyebrow">Legalese</p>
      <h1>{entry.data.title}</h1>
      <p class="muted">Last updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{updated}</time></p>
    </header>
    <section class="tldr wrap" aria-labelledby="tldr-heading">
      <h2 id="tldr-heading" class="eyebrow">tl;dr</h2>
      <ul>
        {entry.data.tldr.map((line) => <li>{line}</li>)}
      </ul>
    </section>
    <div class="prose wrap">
      <Content />
    </div>
  </article>
</Base>
